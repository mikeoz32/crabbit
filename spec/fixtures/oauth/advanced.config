[
  {rabbit, [
    {auth_backends, [rabbit_auth_backend_oauth2]}
  ]},
  {rabbitmq_auth_backend_oauth2, [
    {resource_server_id, <<"rabbitmq">>},
    {verify_aud, true},
    {key_config, [
      {default_key, <<"crabbit-test-key">>},
      {signing_keys, #{
        <<"crabbit-test-key">> => {map, #{
          <<"kty">> => <<"MAC">>,
          <<"alg">> => <<"HS256">>,
          <<"value">> => <<"crabbit-oauth2-integration-secret">>
        }}
      }}
    ]}
  ]}
].
